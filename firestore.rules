rules_version = '2';
// Regras de segurança do Maré Boa (Firestore).
// Colar em: Firebase → Firestore Database → Regras → Publicar.
// Princípios: cada pessoa só mexe no que é dela; ninguém lê dados pessoais de outros;
// mensagens com tamanho máximo e intervalo mínimo; grupos e parceiros só o administrador cria.
service cloud.firestore {
  match /databases/{database}/documents {

    // Conta Google ou e-mail confirmado (o link de confirmação prova que o e-mail é da pessoa)
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && exists(/databases/$(database)/documents/admins/$(me())); }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(me())); }
    function profile() { return get(/databases/$(database)/documents/users/$(me())).data; }
    function optStr(d, k, max) { return !(k in d) || (d[k] is string && d[k].size() <= max); }

    // Perfil: nome, região do CEP (5 dígitos) e consentimento. Só o dono lê e escreve.
    match /users/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['nome', 'regiao', 'criadoEm', 'consent', 'codigo', 'ultimoAcesso', 'acessos', 'pontos', 'nivel', 'selos', 'especies', 'capturas'])
        && request.resource.data.nome is string
        && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 40
        && request.resource.data.regiao is string && request.resource.data.regiao.matches('^[0-9]{5}$')
        && request.resource.data.consent.versao is string;
      allow delete: if signedIn() && me() == uid;

      // Índice das próprias mensagens (para apagar tudo ao excluir a conta)
      match /meusPosts/{pid} {
        allow read, delete: if signedIn() && me() == uid;
        allow create: if signedIn() && me() == uid && request.resource.data.keys().hasOnly(['gid']);
      }
    }

    // Controle de frequência: no mínimo 5 s entre mensagens
    match /limits/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['ultimo']) && request.resource.data.ultimo == request.time;
      allow update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['ultimo']) && request.resource.data.ultimo == request.time
        && request.time > resource.data.ultimo + duration.value(5, 's');
    }

    // Administradores: criados só pelo console do Firebase
    match /admins/{uid} {
      allow read: if signedIn() && me() == uid;
      allow write: if false;
    }

    // Código de amigo: quem sabe o código acha o nome e o ID da pessoa para adicionar num grupo.
    // Ninguém consegue listar os códigos.
    match /codigos/{code} {
      allow get: if hasProfile();
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['uid', 'nome']) && code.size() >= 6;
      allow delete: if signedIn() && resource.data.uid == me();
    }

    // Grupos
    // - públicos (Geral, Vendas e trocas): todos com perfil leem e escrevem; só o administrador cria
    // - privados: qualquer pessoa cria; só os membros veem; o dono adiciona e tira gente;
    //   quem tem o link de convite entra sozinho; qualquer membro pode sair
    function grupo(gid) { return get(/databases/$(database)/documents/groups/$(gid)).data; }
    function podeVer(g) { return hasProfile() && (g.tipo == 'publico' || me() in g.membros); }
    function so(campos) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(campos); }
    match /groups/{gid} {
      allow get, list: if resource.data.tipo == 'publico' || (signedIn() && me() in resource.data.membros) || isAdmin();
      allow create: if (isAdmin() && request.resource.data.tipo == 'publico'
            && request.resource.data.keys().hasOnly(['nome', 'ordem', 'descricao', 'tipo']))
        || (hasProfile() && request.resource.data.tipo == 'privado'
            && request.resource.data.keys().hasOnly(['nome', 'tipo', 'dono', 'membros', 'nomes', 'convite', 'criadoEm'])
            && request.resource.data.dono == me() && request.resource.data.membros == [me()]
            && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 40
            && request.resource.data.convite is string && request.resource.data.convite.size() >= 10
            && request.resource.data.criadoEm == request.time);
      allow update: if (isAdmin() && resource.data.tipo == 'publico')
        // dono: muda nome, membros e convite (continua dono e membro; até 100 pessoas)
        || (hasProfile() && resource.data.tipo == 'privado' && resource.data.dono == me()
            && so(['nome', 'membros', 'nomes', 'convite'])
            && me() in request.resource.data.membros && request.resource.data.membros.size() <= 100
            && request.resource.data.nome is string && request.resource.data.nome.size() >= 2 && request.resource.data.nome.size() <= 40)
        // entrar com o link de convite (só a si mesmo)
        || (hasProfile() && resource.data.tipo == 'privado' && !(me() in resource.data.membros)
            && so(['membros', 'nomes', 'ultimoConvite'])
            && request.resource.data.ultimoConvite == resource.data.convite
            && request.resource.data.membros.toSet() == resource.data.membros.toSet().union([me()].toSet())
            && request.resource.data.membros.size() == resource.data.membros.size() + 1
            && request.resource.data.membros.size() <= 100)
        // sair do grupo (só a si mesmo; o dono apaga o grupo em vez de sair)
        || (signedIn() && resource.data.tipo == 'privado' && me() in resource.data.membros && resource.data.dono != me()
            && so(['membros', 'nomes'])
            && request.resource.data.membros.toSet() == resource.data.membros.toSet().difference([me()].toSet()));
      allow delete: if isAdmin() || (signedIn() && resource.data.dono == me());

      // Mensagens: quem pode ver o grupo lê e escreve; ninguém edita; autor, dono do grupo ou administrador apaga
      match /posts/{pid} {
        allow read: if podeVer(grupo(gid));
        allow create: if podeVer(grupo(gid))
          && request.resource.data.uid == me()
          && request.resource.data.keys().hasOnly(['uid', 'nome', 'texto', 'ponto', 'peixe', 'criadoEm', 'resp', 'mencoes', 'foto', 'nivel'])
          && (!('nivel' in request.resource.data) || (request.resource.data.nivel is int && request.resource.data.nivel >= 0 && request.resource.data.nivel <= 9))
          && (!('resp' in request.resource.data) || (request.resource.data.resp is map && request.resource.data.resp.size() <= 4))
          && (!('mencoes' in request.resource.data) || (request.resource.data.mencoes is list && request.resource.data.mencoes.size() <= 10))
          && (!('foto' in request.resource.data) || (request.resource.data.foto is string && request.resource.data.foto.size() <= 40))
          && request.resource.data.nome == profile().nome
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0 && request.resource.data.texto.size() <= 500
          && optStr(request.resource.data, 'ponto', 60)
          && optStr(request.resource.data, 'peixe', 30)
          && request.resource.data.criadoEm == request.time
          && getAfter(/databases/$(database)/documents/limits/$(me())).data.ultimo == request.time;
        allow update: if false;
        allow delete: if signedIn() && (resource.data.uid == me() || isAdmin() || grupo(gid).get('dono', '') == me());
      }
    }

    // Avisos no celular: cada aparelho guarda o próprio token; só o robô (conta de serviço) lê todos
    match /push/{uid} {
      allow read: if (request.auth != null && request.auth.uid == uid) || isAdmin();
      allow delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['token', 'reg', 'dias', 'avisos', 'atualizado'])
        && request.resource.data.token is string && request.resource.data.token.size() < 400
        && request.resource.data.reg in ['sc', 'pr', 'sp']
        && request.resource.data.dias is list && request.resource.data.dias.size() <= 7
        && request.resource.data.avisos is map && request.resource.data.atualizado == request.time;
    }

    // Coletivo anônimo: condições das pescarias (sem o ponto; só uma área de ~10 km). Login anônimo basta.
    function authed() { return request.auth != null; }
    match /limitesCap/{uid} {
      allow read: if authed() && request.auth.uid == uid;
      allow create: if authed() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['ultimo']) && request.resource.data.ultimo == request.time;
      allow update: if authed() && request.auth.uid == uid && request.resource.data.keys().hasOnly(['ultimo']) && request.resource.data.ultimo == request.time
        && request.time > resource.data.ultimo + duration.value(5, 's');
    }
    // Pontos, diário e agenda do usuário (sincronização entre aparelhos): só o próprio dono lê e grava, nem o administrador
    match /privado/{uid} {
      allow read, delete: if signedIn() && me() == uid;
      allow create, update: if signedIn() && me() == uid
        && request.resource.data.keys().hasOnly(['pontos', 'pdel', 'diario', 'ldel', 'agenda', 'tcal', 'atualizado'])
        && request.resource.data.pontos is string && request.resource.data.diario is string
        && request.resource.data.pdel is string && request.resource.data.ldel is string && request.resource.data.agenda is string;
    }

    // Feed de pescarias (estilo Strava): sem o ponto, só uma área larga do litoral
    match /atividades/{id} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['uid', 'nome', 'nivel', 't', 'sp', 'qty', 'size', 'res', 'isca', 'area', 'texto', 'cond', 'kd', 'nc', 'criadoEm'])
        && (!('kd' in request.resource.data) || request.resource.data.kd.size() == 0)
        && (!('nc' in request.resource.data) || request.resource.data.nc == 0)
        && request.resource.data.criadoEm == request.time
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 40
        && request.resource.data.nivel is int && request.resource.data.t is int
        && request.resource.data.sp is string && request.resource.data.sp.size() <= 30
        && request.resource.data.qty is int && request.resource.data.qty >= 0 && request.resource.data.qty <= 100
        && request.resource.data.res is int && request.resource.data.res >= 0 && request.resource.data.res <= 3
        && request.resource.data.area is string && request.resource.data.area.size() <= 50
        && (!('size' in request.resource.data) || (request.resource.data.size is int && request.resource.data.size <= 300))
        && (!('isca' in request.resource.data) || (request.resource.data.isca is string && request.resource.data.isca.size() <= 40))
        && (!('texto' in request.resource.data) || (request.resource.data.texto is string && request.resource.data.texto.size() <= 280))
        && request.resource.data.cond is map
        && request.resource.data.cond.keys().hasOnly(['mare', 'vento', 'dir', 'lua', 'agua', 'nota', 'frente']);
      // o autor pode completar as condições (pescaria antiga: o app busca o histórico depois)
      allow update: if signedIn() && (
        (resource.data.uid == me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cond'])
          && request.resource.data.cond is map
          && request.resource.data.cond.keys().hasOnly(['mare', 'vento', 'dir', 'lua', 'agua', 'nota', 'frente']))
        // "Boa!": cada pessoa só põe ou tira o próprio nome (não na própria pescaria)
        || (hasProfile() && resource.data.uid != me()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['kd'])
          && request.resource.data.kd is map && request.resource.data.kd.size() <= 500
          && request.resource.data.kd.diff(resource.data.get('kd', {})).affectedKeys().hasOnly([me()])
          && (!(me() in request.resource.data.kd) || (request.resource.data.kd[me()] is string && request.resource.data.kd[me()].size() <= 40)))
        // contador de comentários: sobe ou desce de 1 em 1
        || (hasProfile()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nc'])
          && request.resource.data.nc is int && request.resource.data.nc >= 0
          && (request.resource.data.nc == resource.data.get('nc', 0) + 1 || request.resource.data.nc == resource.data.get('nc', 0) - 1)));
      allow delete: if signedIn() && (resource.data.uid == me() || isAdmin());

      match /kudos/{uid} {
        allow read: if signedIn();
        allow create: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['nome', 'criadoEm'])
          && request.resource.data.nome is string && request.resource.data.nome.size() <= 40
          && request.resource.data.criadoEm == request.time;
        allow delete: if signedIn() && (uid == me() || isAdmin());
      }

      match /coment/{cid} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == me()
          && request.resource.data.keys().hasOnly(['uid', 'nome', 'texto', 'criadoEm'])
          && request.resource.data.nome is string && request.resource.data.nome.size() <= 40
          && request.resource.data.texto is string && request.resource.data.texto.size() >= 1 && request.resource.data.texto.size() <= 300
          && request.resource.data.criadoEm == request.time;
        allow delete: if signedIn() && (resource.data.uid == me() || isAdmin()
          || get(/databases/$(database)/documents/atividades/$(id)).data.uid == me());
      }
    }

    match /capturas/{id} {
      allow read: if authed();
      allow create: if authed() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'reg', 'cel', 't', 'mes', 'sp', 'res', 'qty', 'isca', 'tipo', 'v', 'criadoEm'])
        && request.resource.data.reg in ['sc', 'pr', 'sp']
        && request.resource.data.cel is string && request.resource.data.cel.size() <= 16
        && request.resource.data.t is int && request.resource.data.mes is int
        && request.resource.data.sp is string && request.resource.data.sp.size() <= 30
        && request.resource.data.res is int && request.resource.data.res >= 0 && request.resource.data.res <= 3
        && (!('qty' in request.resource.data) || (request.resource.data.qty is int && request.resource.data.qty >= 0 && request.resource.data.qty <= 100))
        && optStr(request.resource.data, 'isca', 40)
        && request.resource.data.tipo is string && request.resource.data.tipo.size() <= 10
        && request.resource.data.v is map && request.resource.data.v.size() <= 24
        && request.resource.data.criadoEm == request.time
        && getAfter(/databases/$(database)/documents/limitesCap/$(request.auth.uid)).data.ultimo == request.time;
      allow update: if false;
      allow delete: if authed() && resource.data.uid == request.auth.uid;
    }

    // Denúncias: qualquer membro cria; só administrador lê e apaga
    match /reports/{rid} {
      allow create: if hasProfile()
        && request.resource.data.uid == me()
        && request.resource.data.keys().hasOnly(['uid', 'gid', 'pid', 'motivo', 'criadoEm'])
        && request.resource.data.motivo is string && request.resource.data.motivo.size() <= 200
        && request.resource.data.criadoEm == request.time;
      allow read, delete: if isAdmin();
      allow update: if false;
    }

    // Parceiros locais: públicos para leitura; só administrador mexe
    match /partners/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Todo o resto: fechado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
